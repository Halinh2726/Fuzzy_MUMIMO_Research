# ------------------------------------------------------------
# Python environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# IDE and operating system
# ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*~

# ------------------------------------------------------------
# Secrets and local configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------
# DeepMIMO downloaded scenarios
# These can be very large and should be downloaded separately.
# ------------------------------------------------------------
deepmimo_scenarios/
DeepMIMO/
scenarios/

# ------------------------------------------------------------
# Generated research datasets
# Keep only the two small smoke datasets included with the project.
# ------------------------------------------------------------
data/*
!data/synthetic_smoke.npz
!data/umi_smoke.npz

# ------------------------------------------------------------
# Generated experiment outputs
# Keep the distributed smoke outputs, but ignore new research runs.
# ------------------------------------------------------------
outputs/*
!outputs/smoke/
!outputs/smoke/**
!outputs/umi_transfer/
!outputs/umi_transfer/**

# Per-geometry checkpoints can become large
outputs/**/tasks/

# ------------------------------------------------------------
# Temporary and log files
# ------------------------------------------------------------
*.tmp
*.temp
*.log
*.bak
*.swp

# ------------------------------------------------------------
# LaTeX intermediate files
# Keep source .tex and the provided preview PDF.
# ------------------------------------------------------------
docs/*.aux
docs/*.bbl
docs/*.bcf
docs/*.blg
docs/*.fdb_latexmk
docs/*.fls
docs/*.lof
docs/*.lot
docs/*.nav
docs/*.out
docs/*.run.xml
docs/*.snm
docs/*.synctex.gz
docs/*.toc
docs/*.vrb
